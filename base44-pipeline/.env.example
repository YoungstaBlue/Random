# claude_legal pipeline configuration — copy to `.env` and fill in.
# Every value is optional; unset integrations no-op cleanly instead of crashing.
# All variables are prefixed CLAUDE_LEGAL_ and read by claude_legal/config.py.

# ---- Module 1: Core Data & Storage ----
CLAUDE_LEGAL_LOCAL_DB_PATH=./claude_legal_data/claude_legal.db
CLAUDE_LEGAL_BACKUP_DIR=./claude_legal_data/backups
# 32-byte urlsafe-base64 Fernet key for encrypted offline backups.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAUDE_LEGAL_BACKUP_KEY=
# Google Drive sync (service-account JSON path + destination folder id).
CLAUDE_LEGAL_GDRIVE_CREDENTIALS_JSON=
CLAUDE_LEGAL_GDRIVE_FOLDER_ID=

# ---- Module 2: Processing, Integration & Routing ----
CLAUDE_LEGAL_API_HOST=127.0.0.1
CLAUDE_LEGAL_API_PORT=8044
# Comma-separated outbound webhook URLs notified on data changes.
CLAUDE_LEGAL_WEBHOOK_URLS=

# ---- Module 3: AI Analysis & Verification ----
CLAUDE_LEGAL_ANTHROPIC_API_KEY=
CLAUDE_LEGAL_ANTHROPIC_MODEL=claude-opus-4-8

# ---- Block A: Vector-Matrix engine tuning ----
CLAUDE_LEGAL_TFIDF_MAX_FEATURES=50000
CLAUDE_LEGAL_TFIDF_NGRAM_MAX=2
CLAUDE_LEGAL_LSH_NBITS=256
CLAUDE_LEGAL_QUERY_TOP_K=10
